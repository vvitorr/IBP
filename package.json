{
  "name": "ibp-monorepo",
  "private": true,
  "description": "IBP — Intent Based Programming: AI-assisted environment for building React websites.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @ibp/webview build && pnpm --filter ibp build",
    "typecheck": "tsc -p packages/shared && tsc -p apps/extension && tsc -p apps/extension/test && tsc -p apps/webview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ext": "pnpm build && pnpm --filter ibp test:ext",
    "package": "pnpm build && pnpm --filter ibp package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
